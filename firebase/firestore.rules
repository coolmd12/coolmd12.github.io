rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isClassroomMember(classroomId) {
      return signedIn()
        && exists(/databases/$(database)/documents/classrooms/$(classroomId)/members/$(request.auth.uid));
    }

    function isClassroomTeacher(classroomId) {
      return signedIn()
        && get(/databases/$(database)/documents/classrooms/$(classroomId)).data.teacherId
          == request.auth.uid;
    }

    function validUsername(value) {
      return value is string
        && value.size() >= 3
        && value.size() <= 32
        && value.matches('^[a-z0-9]([a-z0-9._]*[a-z0-9])?$');
    }

    function validRolesList(value) {
      return value is list
        && value.size() > 0
        && value.size() <= 2
        && value.hasOnly(['student', 'teacher']);
    }

    // Account can create classrooms if primary role is teacher or roles[] includes teacher.
    function canTeachAccount() {
      return userDoc().role == 'teacher'
        || ('roles' in userDoc() && userDoc().roles.hasAny(['teacher']));
    }

    match /users/{userId} {
      allow read: if isSelf(userId)
        || (signedIn() && resource.data.keys().hasAll(['displayName', 'role']));
      allow create: if isSelf(userId)
        && request.resource.data.keys().hasAll([
          'uid', 'email', 'username', 'displayName', 'role', 'createdAt'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.role in ['student', 'teacher']
        && (
          !('roles' in request.resource.data)
          || validRolesList(request.resource.data.roles)
        )
        && request.resource.data.email == request.auth.token.email.lower()
        && validUsername(request.resource.data.username);
      allow update: if isSelf(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role in ['student', 'teacher']
        && (
          !('roles' in request.resource.data)
          || validRolesList(request.resource.data.roles)
        )
        && (
          // Username immutable once set; legacy users may set it once; roles backfill OK without username.
          (
            !('username' in resource.data)
            && (
              !('username' in request.resource.data)
              || validUsername(request.resource.data.username)
            )
          )
          || (
            'username' in resource.data
            && request.resource.data.username == resource.data.username
          )
        );
      allow delete: if false;
    }

    match /usernames/{username} {
      // Public read so signup can check availability before Auth account exists.
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && validUsername(username);
      allow update, delete: if false;
    }

    match /emails/{email} {
      // Public get so signup step 1 can detect an existing account early.
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && email == request.auth.token.email.lower();
      allow update, delete: if false;
    }

    match /inviteCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.teacherId == request.auth.uid
        && request.resource.data.keys().hasAll(['classroomId', 'teacherId', 'createdAt']);
      allow delete: if signedIn() && resource.data.teacherId == request.auth.uid;
      allow update: if false;
    }

    match /classrooms/{classroomId} {
      allow read: if isClassroomMember(classroomId)
        || isClassroomTeacher(classroomId)
        || (signedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && 'classroomIds' in userDoc()
          && classroomId in userDoc().classroomIds);
      allow create: if signedIn()
        && request.resource.data.teacherId == request.auth.uid
        && canTeachAccount()
        && request.resource.data.keys().hasAll([
          'name', 'teacherId', 'inviteCode', 'createdAt', 'memberCount'
        ]);
      allow update: if isClassroomTeacher(classroomId)
        || (signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount'])
          && request.resource.data.memberCount == resource.data.memberCount + 1);
      allow delete: if isClassroomTeacher(classroomId);

      match /members/{memberId} {
        // Allow reading your own member doc (including "does not exist") so join can check membership.
        allow read: if signedIn() && (
          request.auth.uid == memberId
          || isClassroomMember(classroomId)
          || isClassroomTeacher(classroomId)
        );
        allow create: if signedIn()
          && request.auth.uid == memberId
          && request.resource.data.keys().hasAll(['uid', 'role', 'displayName', 'joinedAt'])
          && request.resource.data.uid == memberId
          && request.resource.data.role in ['student', 'teacher', 'chair'];
        allow delete: if isClassroomTeacher(classroomId) || request.auth.uid == memberId;
        allow update: if isClassroomTeacher(classroomId)
          || (signedIn()
            && request.auth.uid == memberId
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.role == resource.data.role
            && request.resource.data.joinedAt == resource.data.joinedAt
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['displayName', 'photoURL']));
      }

      match /sessions/{sessionId} {
        allow read: if isClassroomMember(classroomId);
        allow create, update, delete: if isClassroomTeacher(classroomId);
      }
    }

    // Open committee rooms — any signed-in user with the link can join.
    function roomDoc(roomId) {
      return get(/databases/$(database)/documents/rooms/$(roomId)).data;
    }

    function isRoomChair(roomId) {
      return signedIn() && roomDoc(roomId).chairId == request.auth.uid;
    }

    function isRoomCreator(roomId) {
      return signedIn() && roomDoc(roomId).createdBy == request.auth.uid;
    }

    match /rooms/{roomId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.keys().hasAll([
          'name', 'createdBy', 'chairId', 'currentStatus', 'createdAt', 'settings', 'speakerQueue'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.currentStatus == 'open'
        && request.resource.data.speakerQueue is list;
      allow update: if signedIn() && (
        isRoomChair(roomId)
        // Claim vacant chair seat on join (transaction pairs with participant create).
        || (
          resource.data.chairId == ''
          && request.resource.data.chairId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['chairId'])
        )
      );
      allow delete: if isRoomCreator(roomId) || isRoomChair(roomId);

      match /participants/{userId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasAll([
            'userId', 'displayName', 'role', 'raisedPlacard', 'joinedAt'
          ])
          && request.resource.data.userId == userId
          && request.resource.data.role in ['delegate', 'chair']
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() > 0
          && request.resource.data.displayName.size() <= 80
          && request.resource.data.raisedPlacard == false;
        allow update: if signedIn() && (
          (
            request.auth.uid == userId
            && request.resource.data.userId == resource.data.userId
            && request.resource.data.joinedAt == resource.data.joinedAt
          )
          || isRoomChair(roomId)
        );
        allow delete: if signedIn()
          && (request.auth.uid == userId || isRoomChair(roomId) || isRoomCreator(roomId));
      }

      match /motions/{motionId} {
        allow read: if signedIn();
        allow create, update: if signedIn();
        allow delete: if isRoomChair(roomId) || isRoomCreator(roomId);
      }

      match /messages/{messageId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;
        allow update, delete: if false;
      }
    }
  }
}
