rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isClassroomMember(classroomId) {
      return signedIn()
        && exists(/databases/$(database)/documents/classrooms/$(classroomId)/members/$(request.auth.uid));
    }

    function isClassroomTeacher(classroomId) {
      return signedIn()
        && get(/databases/$(database)/documents/classrooms/$(classroomId)).data.teacherId
          == request.auth.uid;
    }

    function validUsername(value) {
      return value is string
        && value.size() >= 3
        && value.size() <= 32
        && value.matches('^[a-z0-9]([a-z0-9._]*[a-z0-9])?$');
    }

    function validRolesList(value) {
      return value is list
        && value.size() > 0
        && (
          (value.size() <= 2 && value.hasOnly(['student', 'teacher']))
          || (value.size() == 1 && value.hasOnly(['parent']))
        );
    }

    function isParentOnlyAccount() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && 'roles' in userDoc()
        && userDoc().roles.size() == 1
        && userDoc().roles.hasOnly(['parent']);
    }

    function parentHasDateOfBirth() {
      return isParentOnlyAccount()
        && 'dateOfBirth' in userDoc()
        && userDoc().dateOfBirth is string
        && userDoc().dateOfBirth.size() == 10;
    }

    function linkedParentOf(studentUid) {
      return signedIn()
        && exists(
          /databases/$(database)/documents/parentLinks/$(request.auth.uid + '_' + studentUid)
        );
    }

    // Account can create classrooms if primary role is teacher or roles[] includes teacher.
    function canTeachAccount() {
      return userDoc().role == 'teacher'
        || ('roles' in userDoc() && userDoc().roles.hasAny(['teacher']));
    }

    match /users/{userId} {
      allow read: if isSelf(userId)
        || linkedParentOf(userId)
        || (signedIn() && resource.data.keys().hasAll(['displayName', 'role']));
      // Username optional on create (Google / legacy); editable later from profile.
      allow create: if isSelf(userId)
        && request.resource.data.keys().hasAll([
          'uid', 'email', 'displayName', 'role', 'createdAt'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.role in ['student', 'teacher', 'parent']
        && (
          !('roles' in request.resource.data)
          || validRolesList(request.resource.data.roles)
        )
        && request.resource.data.email == request.auth.token.email.lower()
        && (
          !('username' in request.resource.data)
          || validUsername(request.resource.data.username)
        );
      allow update: if isSelf(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role in ['student', 'teacher', 'parent']
        && (
          !('roles' in request.resource.data)
          || validRolesList(request.resource.data.roles)
        )
        && (
          !('username' in request.resource.data)
          || validUsername(request.resource.data.username)
        );
      allow delete: if isSelf(userId);

      // Own activity timeline (append-only). Linked parents may read.
      match /activity/{eventId} {
        allow read: if isSelf(userId) || linkedParentOf(userId);
        allow create: if isSelf(userId)
          && request.resource.data.keys().hasAll(['kind', 'title', 'at', 'dedupeKey'])
          && request.resource.data.kind is string
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 120
          && request.resource.data.at is int
          && request.resource.data.dedupeKey is string;
        allow update: if isSelf(userId)
          && request.resource.data.dedupeKey == resource.data.dedupeKey
          && request.resource.data.kind == resource.data.kind;
        allow delete: if isSelf(userId);
      }
    }

    // Private family codes — owner read/write; parents never list/read others' codes.
    // Link create validates via get() in parentLinks rules.
    match /familyCodes/{uid} {
      allow read: if isSelf(uid);
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasAll(['uid', 'code', 'rotatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.code is string
        && request.resource.data.code.size() >= 6
        && request.resource.data.code.size() <= 16
        && request.resource.data.rotatedAt is int;
      allow delete: if isSelf(uid);
    }

    match /parentLinks/{linkId} {
      allow read: if signedIn()
        && (resource.data.parentUid == request.auth.uid
          || resource.data.studentUid == request.auth.uid);
      allow create: if signedIn()
        && parentHasDateOfBirth()
        && request.resource.data.parentUid == request.auth.uid
        && request.resource.data.createdByParentUid == request.auth.uid
        && request.resource.data.keys().hasAll([
          'linkId', 'parentUid', 'studentUid', 'studentUsername',
          'createdAt', 'createdByParentUid', 'familyCode'
        ])
        && request.resource.data.linkId == linkId
        && linkId == request.auth.uid + '_' + request.resource.data.studentUid
        && request.resource.data.studentUid is string
        && request.resource.data.studentUid != request.auth.uid
        && request.resource.data.studentUsername is string
        && request.resource.data.createdAt is int
        && request.resource.data.familyCode is string
        && exists(/databases/$(database)/documents/familyCodes/$(request.resource.data.studentUid))
        && get(/databases/$(database)/documents/familyCodes/$(request.resource.data.studentUid)).data.code
          == request.resource.data.familyCode
        && exists(/databases/$(database)/documents/users/$(request.resource.data.studentUid))
        && !(
          'roles' in get(/databases/$(database)/documents/users/$(request.resource.data.studentUid)).data
          && get(/databases/$(database)/documents/users/$(request.resource.data.studentUid)).data.roles.hasOnly(['parent'])
        );
      allow update: if false;
      allow delete: if signedIn()
        && (resource.data.parentUid == request.auth.uid
          || resource.data.studentUid == request.auth.uid);
    }

    match /usernames/{username} {
      // Public read so signup can check availability before Auth account exists.
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && validUsername(username);
      // Owner may release a handle when changing username from profile.
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    match /emails/{email} {
      // Public get so signup step 1 can detect an existing account early.
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && email == request.auth.token.email.lower();
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /inviteCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.teacherId == request.auth.uid
        && request.resource.data.keys().hasAll(['classroomId', 'teacherId', 'createdAt']);
      allow delete: if signedIn() && resource.data.teacherId == request.auth.uid;
      allow update: if false;
    }

    match /classrooms/{classroomId} {
      allow read: if isClassroomMember(classroomId)
        || isClassroomTeacher(classroomId)
        || (signedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && 'classroomIds' in userDoc()
          && classroomId in userDoc().classroomIds);
      allow create: if signedIn()
        && request.resource.data.teacherId == request.auth.uid
        && canTeachAccount()
        && request.resource.data.keys().hasAll([
          'name', 'teacherId', 'inviteCode', 'createdAt', 'memberCount'
        ]);
      allow update: if isClassroomTeacher(classroomId)
        || (signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount'])
          && request.resource.data.memberCount == resource.data.memberCount + 1);
      allow delete: if isClassroomTeacher(classroomId);

      match /members/{memberId} {
        // Allow reading your own member doc (including "does not exist") so join can check membership.
        allow read: if signedIn() && (
          request.auth.uid == memberId
          || isClassroomMember(classroomId)
          || isClassroomTeacher(classroomId)
        );
        allow create: if signedIn()
          && !isParentOnlyAccount()
          && request.auth.uid == memberId
          && request.resource.data.keys().hasAll(['uid', 'role', 'displayName', 'joinedAt'])
          && request.resource.data.uid == memberId
          && request.resource.data.role in ['student', 'teacher', 'chair'];
        allow delete: if isClassroomTeacher(classroomId) || request.auth.uid == memberId;
        allow update: if isClassroomTeacher(classroomId)
          || (signedIn()
            && request.auth.uid == memberId
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.role == resource.data.role
            && request.resource.data.joinedAt == resource.data.joinedAt
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['displayName', 'photoURL']));
      }

      match /sessions/{sessionId} {
        allow read: if isClassroomMember(classroomId);
        allow create, update, delete: if isClassroomTeacher(classroomId);
      }
    }

    // Open committee rooms — any signed-in user with the link can join.
    function roomDoc(roomId) {
      return get(/databases/$(database)/documents/rooms/$(roomId)).data;
    }

    function isRoomChair(roomId) {
      return signedIn() && roomDoc(roomId).chairId == request.auth.uid;
    }

    function isRoomCreator(roomId) {
      return signedIn() && roomDoc(roomId).createdBy == request.auth.uid;
    }

    function isRoomParticipant(roomId) {
      return signedIn()
        && exists(/databases/$(database)/documents/rooms/$(roomId)/participants/$(request.auth.uid));
    }

    match /rooms/{roomId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && !isParentOnlyAccount()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.keys().hasAll([
          'name', 'createdBy', 'chairId', 'currentStatus', 'createdAt', 'settings', 'speakerQueue'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.currentStatus == 'open'
        && request.resource.data.speakerQueue is list;
      allow update: if signedIn() && (
        isRoomChair(roomId)
        // Host may close the room (and clear live floor fields) even if not seated as chair.
        || (
          isRoomCreator(roomId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'closedAt', 'closedBy', 'currentStatus',
              'activeTimer', 'activeCaucus', 'activeMotionId', 'speechTimeBank'
            ])
        )
        // Claim vacant chair seat on join (transaction pairs with participant create).
        || (
          resource.data.chairId == ''
          && request.resource.data.chairId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['chairId'])
        )
      );
      allow delete: if isRoomCreator(roomId) || isRoomChair(roomId);

      match /participants/{userId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && !isParentOnlyAccount()
          && request.auth.uid == userId
          && request.resource.data.keys().hasAll([
            'userId', 'displayName', 'role', 'raisedPlacard', 'joinedAt'
          ])
          && request.resource.data.userId == userId
          && request.resource.data.role in ['delegate', 'chair']
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() > 0
          && request.resource.data.displayName.size() <= 80
          && request.resource.data.raisedPlacard == false;
        allow update: if signedIn() && (
          (
            request.auth.uid == userId
            && request.resource.data.userId == resource.data.userId
            && request.resource.data.joinedAt == resource.data.joinedAt
          )
          || isRoomChair(roomId)
        );
        allow delete: if signedIn()
          && (request.auth.uid == userId || isRoomChair(roomId) || isRoomCreator(roomId));
      }

      match /motions/{motionId} {
        allow read: if signedIn();
        allow create, update: if signedIn();
        allow delete: if isRoomChair(roomId) || isRoomCreator(roomId);
      }

      match /messages/{messageId} {
        // Only people who joined this room can read/send its chat.
        allow read: if isRoomParticipant(roomId);
        allow create: if isRoomParticipant(roomId)
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.keys().hasAll([
            'userId', 'displayName', 'text', 'createdAt'
          ])
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() > 0
          && request.resource.data.displayName.size() <= 120
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.createdAt is int;
        // Seat-label sync after role/country change (own messages only).
        allow update: if isRoomParticipant(roomId)
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.text == resource.data.text
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() > 0
          && request.resource.data.displayName.size() <= 120;
        allow delete: if false;
      }
    }

    // Registered-user counter. Anyone signed in may increment on first profile create;
    // only the founder may read the count.
    match /stats/{docId} {
      allow read: if signedIn()
        && request.auth.token.email.lower() == 'dhyanvim@gmail.com';
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['userCount', 'updatedAt'])
        && request.resource.data.userCount is int
        && request.resource.data.userCount == 1
        && request.resource.data.updatedAt is number;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userCount', 'updatedAt'])
        && request.resource.data.userCount is int
        && request.resource.data.updatedAt is number
        && (
          request.resource.data.userCount == resource.data.userCount + 1
          || (
            request.resource.data.userCount == resource.data.userCount - 1
            && request.resource.data.userCount >= 0
          )
        );
      allow delete: if false;
    }
  }
}
